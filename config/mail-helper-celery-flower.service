[Unit]
Description=KI-Mail-Helper Flower Monitoring (Celery Web UI) — DEV ONLY
After=network.target redis-server.service mail-helper-celery-worker.service
Requires=redis-server.service

[Service]
Type=simple
User=mailhelper
Group=mailhelper
# WICHTIG: Pfade anpassen! Muessen mit mail-helper.service uebereinstimmen.
WorkingDirectory=/opt/KI-Mail-Helper
Environment="PATH=/opt/KI-Mail-Helper/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/KI-Mail-Helper/.env

# DEV ONLY: localhost binden. Task-Results können PII enthalten — nie öffentlich!
# Produktion (CT 134): diesen Service NICHT installieren.
ExecStart=/opt/KI-Mail-Helper/venv/bin/celery \
    -A src.celery_app flower \
    --address=127.0.0.1 \
    --port=5555 \
    --url_prefix=flower \
    --max_tasks=10000 \
    --purge_offline_workers=60

Restart=always
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
