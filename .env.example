# ═══════════════════════════════════════════════════════════════════════════════
# KI-Mail-Helper v2.0 - Multi-User Edition
# Konfigurationsvorlage (.env.example)
#
# Keine Inline-Kommentare (KEY=value # text). systemd EnvironmentFile nimmt
# alles nach dem = als Wert — python-dotenv kann das nicht mehr korrigieren.
# Kommentare nur auf eigenen Zeilen.
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# 🔑 PFLICHT: Sicherheit
# ═══════════════════════════════════════════════════════════════
# Flask Secret Key (NEVER commit actual value to git!)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY wird bevorzugt gelesen; FLASK_SECRET_KEY ist Legacy-Alias (00_env_validator).
# Ohne beide startet die App mit Ephemeral-Key (Sessions/CSRF ungültig nach Neustart).
SECRET_KEY=
FLASK_SECRET_KEY=
FLASK_ENV=production

# ═══════════════════════════════════════════════════════════════
# 🐘 PFLICHT: PostgreSQL Datenbank
# ═══════════════════════════════════════════════════════════════
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://mail_helper:DEIN_SICHERES_PASSWORT@localhost:5432/mail_helper

# ═══════════════════════════════════════════════════════════════
# 📡 PFLICHT: Redis (Session, Celery Broker, Results)
# ═══════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ═══════════════════════════════════════════════════════════════
# 🛡️ Rate Limiting (Flask-Limiter)
# ═══════════════════════════════════════════════════════════════
# "auto" (Default) erkennt Redis automatisch (nutzt Host/Port aus REDIS_URL, DB 3)
# und faellt nur zurueck auf memory:// wenn Redis nicht erreichbar ist.
# WICHTIG in Produktion: memory:// zaehlt PRO Gunicorn-Worker separat, d.h.
# "5 Versuche/Minute" auf /login wird effektiv "5 x Worker-Anzahl" - Redis explizit
# setzen, wenn Auto-Detection aus irgendeinem Grund nicht greifen soll:
RATE_LIMIT_STORAGE=auto
# Explizit: RATE_LIMIT_STORAGE=redis://localhost:6379/3

# ═══════════════════════════════════════════════════════════════
# 🤖 KI-BACKEND (wähle eins)
# ═══════════════════════════════════════════════════════════════
# ollama | openai | anthropic | mistral
AI_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Muss gesetzt sein (sonst fällt 15_provider_utils auf localhost zurück)
OLLAMA_API_URL=http://localhost:11434
# Lokales Ollama: Chat/Reply/Optimize (Sekunden, Default 900)
OLLAMA_TIMEOUT=900
# Hugging Face Cache für Opus-MT (muss für User mailhelper lesbar sein)
HF_HOME=/opt/KI-Mail-Helper/.cache/huggingface
# Embedding inkl. Kaltstart (Sekunden, Default 120)
OLLAMA_EMBEDDING_TIMEOUT=120
# Klassifizierung: Body-Limit für LLM-Prompt (Zeichen, Default 6000)
CLASSIFICATION_BODY_MAX=6000
# Ollama /api/chat pro Request (EVO-Ollama globaler Kontext bleibt unberührt)
OLLAMA_CHAT_NUM_CTX=8192
OLLAMA_CHAT_NUM_PREDICT=1024
OLLAMA_CHAT_KEEP_ALIVE=10m
# Qwen3: think explizit aus (Default), sonst leeres JSON bei Klassifikation
# OLLAMA_CHAT_THINK=false
# Bei OLLAMA_CHAT_THINK=true: höheres num_predict für Klassifikation/Audit
# OLLAMA_CHAT_NUM_PREDICT_THINK=4096
# Denk-Fähigkeit anderer Modelle: Ollama /api/show (capabilities) + DB-Cache 7 Tage
# (Tabelle ollama_model_capability_cache). Bei /api/show-Fehler: kein Cache, UI „unbekannt“.
# Ordner-Audit Scam: Layer-1 Auto-SCAM ab Score, LLM-Grauzone ab Score (Default 80 / 40)
AUDIT_SCAM_LAYER1_AUTO=80
AUDIT_SCAM_DBL_MAX=50
# AUDIT_SCAM_GRAY_DNS_MAX=40
# AUDIT_SCAM_GRAY_RDAP_MAX=20
# DOMAIN_REPUTATION_CACHE_HOURS=24
# DOMAIN_REPUTATION_UNAVAILABLE_CACHE_MINUTES=10
# BRAND_HEALTH_MAX_DOMAINS=100
AUDIT_SCAM_LAYER1_LLM_MIN=40
AUDIT_SCAM_LLM_ENABLED=true
# Optional: eigenes Modell für Audit-Identität (Default: OLLAMA Chat-Modell)
# AUDIT_SCAM_LLM_MODEL=qwen3:8b
# Denken für Audit-LLM (Default false; User kann in /settings überschreiben)
# AUDIT_SCAM_LLM_THINK=false
AUDIT_SCAM_LLM_TIMEOUT=90
# Max. Identitäts-LLM-Aufrufe pro Ordner-Audit-Scan (Grauzone, nach Layer-1-Ranking).
# Code-Default ohne Variable: 150 — wenn du z. B. AUDIT_SCAM_LLM_MAX_PER_SCAN=25 setzt, überschreibt das den Default (Scan-Hinweis zeigt den effektiven Wert).
# AUDIT_SCAM_LLM_MAX_PER_SCAN=150
# Max. LLM-Zeit ab Start der LLM-Batch-Phase pro Scan (Sekunden, zusätzlich zum Zähler)
# AUDIT_SCAM_LLM_TIME_BUDGET_SEC=600
# «Rest prüfen» (HTTP): kleineres Budget, zählt gegen manuelles Tageslimit
# AUDIT_SCAM_LLM_CONTINUE_MAX_PER_CALL=40
# AUDIT_SCAM_LLM_CONTINUE_TIME_BUDGET_SEC=90
# Manuelle Identitäts-Checks pro User/Tag (Ordner-Audit Button, kein Scan-Budget)
# AUDIT_SCAM_LLM_MANUAL_MAX_PER_DAY=50
# Optional: Cloud-Provider für Audit-Identität (User kann in /settings überschreiben)

# ═══════════════════════════════════════════════════════════════
# 🏷️ ORDNER-AUDIT: Marken-Domain-Health (DNS / DBL / RDAP)
# «Domains prüfen» / Speichern der Markenliste; RDAP-Overrides für .ch, .de, …
# ═══════════════════════════════════════════════════════════════
# Admin-Notbremse: false erzwingt Marken-RDAP aus (UI-Checkbox pro Nutzer sonst maßgeblich)
# BRAND_DOMAIN_HEALTH_RDAP=false
# AUDIT_SCAM_RDAP_SENDER=false
# BRAND_HEALTH_MAX_DOMAINS=100
# DOMAIN_REPUTATION_CACHE_HOURS=24
# DOMAIN_REPUTATION_UNAVAILABLE_CACHE_MINUTES=10
# RDAP_TRANSIENT_CACHE_MINUTES=15
# RDAP_STABLE_CACHE_HOURS=168
# RDAP_MIN_INTERVAL_SECONDS=3
# RDAP_NIC_CH_INTERVAL_SECONDS=4
# RDAP_RETRY_AFTER_MAX_SECONDS=15
# RDAP_SERVER_BLOCK_SECONDS=120
# RDAP_USE_CIRCUIT_BREAKER=false
# RDAP_REDIS_THROTTLE=true
# BRAND_HEALTH_STOP_ON_RDAP_429=true
# BRAND_HEALTH_RDAP_AUTO_FOLLOWUP=false
# BRAND_HEALTH_RDAP_BUDGET_SECONDS=480
# BRAND_HEALTH_RDAP_FOLLOWUP_CHUNK=25
# BRAND_HEALTH_RDAP_FOLLOWUP_COOLDOWN=90

# ═══════════════════════════════════════════════════════════════
# 📊 ORDNER-AUDIT: Tranco-Beliebtheitsliste (Fehlalarm-Dämpfer)
# SQLite data/tranco/ — nicht im Git. Kein Echtheits-Beweis. docs/audit/tranco-popularity.md
# Nach git pull als root: chown -R mailhelper data/tranco/
# TRANCO_TOP_N nur erhöhen nach: python scripts/tranco_domain_coverage.py …
# ═══════════════════════════════════════════════════════════════
# TRANCO_LIST_ID=
# TRANCO_TOP_N=100000
# TRANCO_DATA_DIR=/opt/KI-Mail-Helper/data/tranco
# TRANCO_DB_PATH=
# TRANCO_AUTO_UPDATE=true
# TRANCO_DOWNLOAD_URL=
# TRANCO_DOWNLOAD_MODE=zip

# ═══════════════════════════════════════════════════════════════
# 👤 ORDNER-AUDIT: App-Administrator (Tranco-Button + Celery-Beat)
# Kommagetrennte Login-Namen; leer = nur User mit id=1
# ═══════════════════════════════════════════════════════════════
# APP_ADMIN_USERNAMES=deinlogin

# Redis Sync-Lock TTL + Verlängerung bei Progress (Sekunden, Default 7200)
MAIL_SYNC_LOCK_TIMEOUT=7200

# Cloud-KI API Keys (nur wenn AI_BACKEND entsprechend gesetzt; Werte nur in .env, nie committen)
# OPENAI_API_KEY=placeholder
# ANTHROPIC_API_KEY=placeholder
# MISTRAL_API_KEY=placeholder

# Modell-Freigabe (optional): AI_MODELS_<PROVIDER>_<ROLLE>, Rolle BASE|OPTIMIZE|EMBEDDING|AUDIT
# Komma-Liste oder fnmatch-Glob (z. B. gpt-4o*). Leer/unset = Registry-Defaults, dann Live-API gefiltert.
# Alle Live-Modelle (nach UI-Filter): z. B. AI_MODELS_OPENAI_BASE=*
# AI_MODELS_UI_FILTER=true blendet Snapshots (-YYYY-MM-DD), -preview, -codex, -search aus.
# AI_MODELS_OPENAI_BASE=gpt-4.1-mini,gpt-4o-mini
# AI_MODELS_OPENAI_OPTIMIZE=gpt-4.1,gpt-4o
# AI_MODELS_OPENAI_EMBEDDING=text-embedding-3-small
# AI_MODELS_OPENAI_AUDIT=gpt-4.1-mini
# AI_MODELS_ANTHROPIC_BASE=claude-fable-5-1
# AI_MODELS_ANTHROPIC_OPTIMIZE=claude-sonnet-5-5,claude-opus-5-5
# AI_MODELS_ANTHROPIC_AUDIT=claude-fable-5-1
# AI_MODELS_MISTRAL_BASE=mistral-small-latest
# AI_MODELS_MISTRAL_OPTIMIZE=mistral-large-latest
# AI_MODELS_OLLAMA_BASE=llama3.2:1b,llama3.2:3b
# AI_MODELS_OLLAMA_EMBEDDING=all-minilm:22m,bge-m3

# ═══════════════════════════════════════════════════════════════
# 🌐 WEB-SERVER
# ═══════════════════════════════════════════════════════════════
# 127.0.0.1 = nginx auf demselben Host; 0.0.0.0 = Proxy auf anderem Host
WEB_HOST=127.0.0.1
WEB_PORT=5000
# true nur für Development
FLASK_DEBUG=false

# ═══════════════════════════════════════════════════════════════
# 🔒 HTTPS & SECURITY (Production)
# ═══════════════════════════════════════════════════════════════
FORCE_HTTPS=true
SESSION_LIFETIME_MINUTES=60
SESSION_COOKIE_SECURE=true
BEHIND_REVERSE_PROXY=true
# Hintergrundjobs: DEK in service_tokens (verschlüsselt mit SECRET_KEY), TTL in Tagen (1–7)
SERVICE_TOKEN_TTL_DAYS=1

# ═══════════════════════════════════════════════════════════════
# 📧 GOOGLE OAUTH (optional für Gmail-Zugriff)
# ═══════════════════════════════════════════════════════════════
# Google Cloud Console: https://console.cloud.google.com
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=placeholder
# GOOGLE_REDIRECT_URI=https://your-domain.com/settings/mail-account/google/callback

# ═══════════════════════════════════════════════════════════════
# ⚠️ WICHTIG: KEINE MAIL-CREDENTIALS HIER!
# ═══════════════════════════════════════════════════════════════
# Mail-Account Passwörter, IMAP/SMTP Credentials etc. werden
# über das Web-UI eingegeben und verschlüsselt in der DB gespeichert.
# Das ist Teil der Zero-Knowledge-Architektur!
